\mathbb{E}_t \left[
\sum_{t=0}^{\infty} 
\left(\gamma_{BB}\right)^{t} 
\left(
\begin{align}&
D_{HI}[t]
-D_{HI}[i,t-1] \; \frac{(1+r_{BB,HI})}{\pi[t]}
\\&
+B_{BB,G}[i,t]
-B_{BB,G}[i,t-1] \; \frac{1+r_{G,BB}[i,t]}{\pi[t]}
\\&
+L_{BB,PG}[i,t-1] \; \frac{(1+r_{BB,PG}[i,t]-\delta_{PG})}{\pi[t]}

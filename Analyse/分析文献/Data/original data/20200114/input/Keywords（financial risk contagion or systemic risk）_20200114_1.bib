@article{ ISI:000360061400001,
Author = {Baek, Seungho and Cursio, Joseph D. and Cha, Seung Y.},
Title = {{Nonparametric Factor Analytic Risk Measurement in Common Stocks in
   Financial Firms: Evidence from Korean Firms}},
Journal = {{ASIA-PACIFIC JOURNAL OF FINANCIAL STUDIES}},
Year = {{2015}},
Volume = {{44}},
Number = {{4}},
Pages = {{497-536}},
Month = {{AUG}},
Abstract = {{This research examines the efficiency of nonparametric factor analytic
   approaches in measuring risk in common stocks of Korean financial firms
   from the risk-management perspective. This paper shows that using only
   one risk factor extracted from principal component analysis, the
   parallel shift or market movement factor, has sufficient accuracy for
   downside risk measures. We assess accuracy by applying Monte Carlo
   simulation to obtain VaR and ES for the Korean financial sector and
   industries within the financial sector (banks, insurance companies, and
   investment andsecurity trading companies), and further estimate the risk
   contagious effect on financial firms.}},

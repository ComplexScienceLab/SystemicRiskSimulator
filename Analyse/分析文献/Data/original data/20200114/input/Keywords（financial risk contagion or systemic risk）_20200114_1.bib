   Deng, Yang, Huazhong Univ Sci \& Technol, Sch Management, Wuhan 430074, Hubei, Peoples R China.
   Zeng, Yan, Sun Yat Sen Univ, Lingnan Univ Coll, Guangzhou 510275, Guangdong, Peoples R China.
   Li, Zhirui, Sun Yat Sen Univ, Sch Math, Guangzhou 510275, Guangdong, Peoples R China.}},
DOI = {{10.1016/j.econmod.2018.09.032}},

@article{ ISI:000423499200001,
Author = {Albu, Lucian Liviu and Lupu, Radu and Calin, Adrian Cantemir},
Title = {{RISK GENERATING INDUSTRIES FOR EUROPEAN STOCK MARKETS}},
Journal = {{ECONOMIC COMPUTATION AND ECONOMIC CYBERNETICS STUDIES AND RESEARCH}},
Year = {{2017}},
Volume = {{51}},
Number = {{4}},
Pages = {{5-17}},
Abstract = {{The analysis of contagion received a substantioanl dose of academic
   attention. This paper aims to determine the potential contagion effects
   for large set of financial assets. We employ 5-minute closing prices for
   the companies included in STOXX600 and build a methdological framework
   that allows the computation of simple differences between the
   Cornish-Fisher VaR and the standard normal distribution VaR dynamics.
   These differences account for the amount of risk that is generated by
   the non-normality of the distribution of log-returns, more precisely the
   part that is spurred by the skewness and kurtosis indicators. These
   measures are synthesized at industry bevel and submitted to a causality
   analysis. Our approach allows us to pinpoint possible inter-industry
   spillover effects and we find the industries that have the propensity to
   inject risk in the system via a Granger-causuality test.}},

@article{ ISI:000350825400002,
Author = {Canofari, Paolo and Marini, Giancarlo and Piersanti, Giovanni},
Title = {{Expectations and systemic risk in EMU government bond spreads}},
Journal = {{QUANTITATIVE FINANCE}},
Year = {{2015}},
Volume = {{15}},
Number = {{4, SI}},
Pages = {{711-724}},
Month = {{APR 3}},
Abstract = {{This paper explores the determinants of 10-year sovereign bond spreads
   over the German Bund benchmark in the Euro Zone from 2000 to 2013,
   relying on cross-country quarterly data panel analysis. The paper focal
   point is the role of contagion and euro break-up risks in widening the
   sovereign bond yield differentials among EU member countries. Using a
   novel synthetic index capable of monitoring the sustainability of
   currency unions, the paper finds that market expectations of a euro's
   break up and contagion from Greece were fundamental drivers of sovereign
   risk premia in peripheral countries.}},

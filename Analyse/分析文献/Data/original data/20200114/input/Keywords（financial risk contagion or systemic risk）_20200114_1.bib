@article{ ISI:000354589200013,
Author = {Souza, Sergio R. S. and Tabak, Benjamin M. and Silva, Thiago C. and
   Guerra, Solange M.},
Title = {{Insolvency and contagion in the Brazilian interbank market}},
Journal = {{PHYSICA A-STATISTICAL MECHANICS AND ITS APPLICATIONS}},
Year = {{2015}},
Volume = {{431}},
Pages = {{140-151}},
Month = {{AUG 1}},
Abstract = {{This paper proposes a new way to model and analyze contagion in
   interbank networks. We use a unique dataset from the Brazilian financial
   system and include all active financial intermediaries. We show that the
   contagion chain has a short propagation path. We find that first-round
   contagion is generated only by banks and that medium-sized banks can
   generate contagion, which implies that size is not the sole determinant
   of importance within networks. Most vulnerable financial institutions
   are not banks. Finally, we compute a lower bound for the financial
   system expected losses in a 1-year horizon. The results contribute to
   the development of a financial stability-monitoring toolkit. (C) 2015
   Elsevier B.V. All rights reserved.}},

@article{ ISI:000393720200006,
Author = {Liu, Chih-Liang and Yang, Hsin-Feng},
Title = {{Systemic risk in carry-trade portfolios}},
Journal = {{FINANCE RESEARCH LETTERS}},
Year = {{2017}},
Volume = {{20}},
Pages = {{40-46}},
Month = {{FEB}},
Abstract = {{Risk contagion between carry trade portfolios and stock markets had been
   explored in literatures, leaving inconsistent controversy. Instead of
   exploring ordinary return-volatility spillovers, this paper focuses on a
   systemic contagion, the tail risk conditional on extreme events in other
   markets. Using a conditional value-at-risk (CoVaR) model, we contribute
   to this line of literature by showing that there is bilateral systemic
   contagion between carry trades and stock markets in the U.S., European,
   or Asia-Pacific regions. Such a systemic contagion is particularly
   significant during the 2000-2001 dot-com bubble and 2007-2009 U.S.
   credit crisis. (C) 2016 Elsevier Inc. All rights reserved.}},

@article{ ISI:000381841900033,
Author = {Kuzubas, Tolga Umut and Saltoglu, Burak and Sever, Can},
Title = {{Systemic risk and heterogeneous leverage in banking networks}},
Journal = {{PHYSICA A-STATISTICAL MECHANICS AND ITS APPLICATIONS}},
Year = {{2016}},
Volume = {{462}},
Pages = {{358-375}},
Month = {{NOV 15}},
Abstract = {{This study probes systemic risk implications of leverage heterogeneity
   in banking networks. We show that the presence of heterogeneous
   leverages drastically changes the systemic effects of defaults and the
   nature of the contagion in interbank markets. Using financial leverage
   data from the US banking system, through simulations, we analyze the
   systemic significance of different types of borrowers, the evolution of
   the network, the consequences of interbank market size and the impact of
   market segmentation. Our study is related to the recent Basel III
   regulations on systemic risk and the treatment of the Global
   Systemically Important Banks (GSIBs). We also assess the extent to which
   the recent capital surcharges on GSIBs may curb financial fragility. We
   show the effectiveness of surcharge policy for the most-levered banks
   vis-a-vis uniform capital injection. (C) 2016 Elsevier B.V. All rights
   reserved.}},

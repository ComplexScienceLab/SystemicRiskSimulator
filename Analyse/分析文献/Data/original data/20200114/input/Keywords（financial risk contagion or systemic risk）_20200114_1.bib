@article{ ISI:000336410900006,
Author = {Choi, Dong Beom},
Title = {{Heterogeneity and Stability: Bolster the Strong, Not the Weak}},
Journal = {{REVIEW OF FINANCIAL STUDIES}},
Year = {{2014}},
Volume = {{27}},
Number = {{6}},
Pages = {{1830-1867}},
Month = {{JUN}},
Abstract = {{We first study a stylized model of self-fulfilling panic among agents
   with differing fragilities to strategic risk and show that depending on
   the severity of coordination problems, the panic trigger threshold can
   depend only on one type's fragility. We then present a model of systemic
   panic among financial institutions with heterogeneous fragilities to
   financial spillovers. Concerns about potential spillovers generate
   strategic interaction, triggering a pre-emption game in which one tries
   to exit the market before others to avoid spillovers. Although financial
   contagion originates in weaker institutions, systemic risk can
   critically depend on financial health of stronger in the contagion
   chain. In this case, bolstering the strong, rather than the weak, more
   effectively enhances systemic stability.}},

Note = {{2013 Conference on Network-Approaches-to-Interbank-Markets (NAIM 2013),
   Castellon, SPAIN, MAY 30-31, 2013}},
Abstract = {{Financial institutions are highly interconnected. Consequently, they
   form complex systems which are inherently unstable. This paper reviews
   empirical research on the instability of complex interbank systems.
   Three network approaches are distinguished: descriptions of interbank
   exposure networks; simulation and modelling; and the development of new
   metrics to describe network topology and individual banks' relative
   importance. The paper concludes by inferring policy implications and
   priorities for future research.}},

@article{ ISI:000333061400008,
Author = {Lee, Li Way},
Title = {{Merger wave in a small world: Two views}},
Journal = {{JOURNAL OF SOCIO-ECONOMICS}},
Year = {{2013}},
Volume = {{43}},
Pages = {{68-71}},
Month = {{APR}},
Abstract = {{I attempt a more balanced assessment of mergers in terms of systemic
   risk versus other effects. First, using the simplest network model, I
   illustrate how mergers can increase systemic risk by reducing the degree
   of separation among firms. Then, recasting the firms in a simple
   economic model that features consumers explicitly, I show how a merger
   wave - a contagious urge to merge - can occur and what benefit it may
   bring to consumers. Together, these two models suggest that there is a
   tradeoff to consider: While a merger wave may result in higher systemic
   risk, it may also bring about higher consumer welfare. (C) 2013 Elsevier
   Inc. All rights reserved.}},
Publisher = {{ELSEVIER SCIENCE INC}},
Address = {{360 PARK AVE SOUTH, NEW YORK, NY 10010-1710 USA}},

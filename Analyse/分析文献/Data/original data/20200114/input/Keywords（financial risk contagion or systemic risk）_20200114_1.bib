@article{ ISI:000466837700002,
Author = {Karkowska, Renata and Kravchuk, Igor},
Title = {{Identification of global systemically important stock exchange}},
Journal = {{EQUILIBRIUM-QUARTERLY JOURNAL OF ECONOMICS AND ECONOMIC POLICY}},
Year = {{2019}},
Volume = {{14}},
Number = {{1}},
Pages = {{31-51}},
Month = {{MAR}},
Abstract = {{Research background: Increased regulations reducing systemic risk are
   essentially underpinned by the understanding of the global nature and
   sources of instability of the financial system. In the economic
   literature, there are many arguments presented by critical supporters
   and opponents of measuring and reporting global systemically important
   entities.
   Purpose of the article: In response to the requirements of regulators,
   the article seeks to identify systematically important regulated stock
   markets for selected global stock exchanges by developing a composite
   ratio. Additionally, it provides empirical evidence concerning their
   risk exploration.
   Methods: The proposed method uses weighted average values of indicators
   grouped in four categories: (1) market size, (2) cross-jurisdictional
   activity and interconnectedness, (3) substitutability, (4) complexity.
   The research covers stock exchanges, reported to WFE, spanning the
   period 2008-2017.
   Findings \& Value added: The study finds that the problem of systemic
   risk on global stock exchanges is growing despite numerous prudential
   regulations. In order to obtain a more complete assessment of market
   systemic sensitivity, regulators should take into account a wider range
   of indicators and calculations such as cross-jurisdictional activity and
   market complexity.}},

Language = {{English}},
Affiliation = {{Ly, KC (Reprint Author), Univ Glasgow, Adam Smith Business Sch, Univ Ave, Glasgow G12 8QQ, Lanark, Scotland.
   Ly, Kim Cuong; Chen, Zhizhen; Wang, Senyu; Jiang, Yuxiang, Univ Glasgow, Adam Smith Business Sch, Univ Ave, Glasgow G12 8QQ, Lanark, Scotland.}},

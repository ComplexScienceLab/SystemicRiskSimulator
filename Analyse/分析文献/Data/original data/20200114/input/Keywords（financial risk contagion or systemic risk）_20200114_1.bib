@article{ ISI:000435531300008,
Author = {Azizpour, S. and Giesecke, K. and Schwenkler, G.},
Title = {{Exploring the sources of default clustering}},
Journal = {{JOURNAL OF FINANCIAL ECONOMICS}},
Year = {{2018}},
Volume = {{129}},
Number = {{1}},
Pages = {{154-183}},
Month = {{JUL}},
Abstract = {{We study the sources of corporate default clustering in the United
   States. We reject the hypothesis that firms' default times are
   correlated only because their conditional default rates depend on
   observable and latent systematic factors. By contrast, we find strong
   evidence that contagion, through which the default by one firm has a
   direct impact on the health of other firms, is a significant clustering
   source. The amount of clustering that cannot be explained by contagion
   and firms' exposure to observable and latent systematic factors is
   insignificant. Our results have important implications for the pricing
   and management of correlated default risk. (C) 2018 Elsevier B.V. All
   rights reserved.}},
Publisher = {{ELSEVIER SCIENCE SA}},

@article{ ISI:000488997600021,
Author = {Simaan, Majeed and Gupta, Aparna and Kar, Koushik},
Title = {{Filtering for risk assessment of interbank network}},
Journal = {{EUROPEAN JOURNAL OF OPERATIONAL RESEARCH}},
Year = {{2020}},
Volume = {{280}},
Number = {{1}},
Pages = {{279-294}},
Month = {{JAN}},
Abstract = {{Our paper contributes to the recent macroprudential policy addressing
   the resilience of financial systems in terms of their
   interconnectedness. We argue that beneath an interbank market, there is
   a fundamental latent network that affects the liquidity distributions
   among banks. To investigate the interbank market, we propose a framework
   that identifies such latent network using a statistical learning
   procedure. The framework reverse engineers overnight signals observed as
   banks conduct their reserve management on a daily basis. Our
   simulation-based results show that possible disruptions in funds supply
   are highly affected by the interconnectedness of the latent network.
   Hence, the proposed framework serves as an early warning system for
   regulators to monitor the overnight market and to detect ex-ante
   possible disruptions based on the inherent network characteristics. (C)
   2019 Elsevier B.V. All rights reserved.}},

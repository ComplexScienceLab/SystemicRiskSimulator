ISSN = {{1042-9573}},
EISSN = {{1096-0473}},
Keywords = {{Contagion; Macroprudential; Margin call; Repo; Shadow banking; Systemic
   risk}},
Keywords-Plus = {{FIRE SALES; LIQUIDITY; LEVERAGE; RISK}},

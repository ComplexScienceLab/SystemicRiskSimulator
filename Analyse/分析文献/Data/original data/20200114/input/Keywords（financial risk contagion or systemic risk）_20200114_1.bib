@article{ ISI:000373236900001,
Author = {Kim, Jeong-Bon and Li, Li and Ma, Mary L. Z. and Song, Frank M.},
Title = {{CEO option compensation and systemic risk in the banking industry}},
Journal = {{ASIA-PACIFIC JOURNAL OF ACCOUNTING \& ECONOMICS}},
Year = {{2016}},
Volume = {{23}},
Number = {{2}},
Pages = {{131-160}},
Month = {{APR 2}},
Abstract = {{We document that CEO risk-taking incentives induced by stock option
   compensation increase a bank's contribution to systemic distress risk
   and systemic crash risk through reacting to common risk exposure of the
   banking industry. We also find that this relation operates through
   channels of engagement in non-interest income-generating activities and
   maturity mismatch associated with short-term debt financing. Further
   analysis reveals that CEO option-based risk-taking incentives increase
   investments in innovative financial products that form naturally
   interconnected networks, which increase systemic risk. Finally, we show
   that market illiquidity and financial crisis accentuate the relation
   between CEO risk-taking incentives and systemic risk.}},

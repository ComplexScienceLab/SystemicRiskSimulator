@article{ ISI:000457665700023,
Author = {Pino, Gabriel and Herrera, Rodrigo and Rodriguez, Alejandro},
Title = {{Geographical spillovers on the relation between risk-taking and market
   power in the US banking sector}},
Journal = {{NORTH AMERICAN JOURNAL OF ECONOMICS AND FINANCE}},
Year = {{2019}},
Volume = {{47}},
Pages = {{351-364}},
Month = {{JAN}},
Abstract = {{This paper investigates the relation between risk taking and market
   power in the US banking sector by introducing the effect of geographical
   spillovers caused by the transmission of risk taking among banks. For
   this purpose, we use spatial econometrics. Our results support a
   negative relation between risk taking and market power. The transmission
   of risk taking causes significant geographical spillovers, which
   increases the magnitude of the relation under analysis here. Moreover,
   the spillover effect is found to be stronger during the Subprime-crisis
   period when we noted an increased in the transmission of risk taking of
   banks.}},

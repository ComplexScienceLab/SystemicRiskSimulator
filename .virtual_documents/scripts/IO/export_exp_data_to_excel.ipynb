import os

import h5py
import numpy as np
import xlwings as xw
import openpyxl as xl
from openpyxl.cell.cell import Cell
from openpyxl.styles import PatternFill,Font,Alignment,Border,Side
import openpyxl.utils as xlutils
import pandas as pd
#
# Open an existing file using default properties.
#






print("start")
# os.chdir("/Users/ethan/LocalFiles/ResearchFile/SystemicRisk")
os.getcwd()
# root_path = os.getcwd()
root_path = "/Users/ethan/LocalFiles/ResearchFile/SystemicRisk"






folder_exp = "test_20220527153746"
path_root_exp = os.path.join(root_path, "data/sims")
path_exp = os.path.join(path_root_exp, folder_exp)
folder_exp_output_data = "exp_output_data"
folder_exp_analyses = "analyses"
folderpath_exp_output_data = os.path.join(path_exp, folder_exp_output_data)
folderpath_exp_analyses = os.path.join(path_exp, folder_exp_analyses)
if not os.path.exists(folderpath_exp_analyses):
    os.makedirs(folderpath_exp_analyses)
filename_excel_exp_data = "exp_data.xlsx"
filepath_excel_exp_data = os.path.join(
    folderpath_exp_analyses, filename_excel_exp_data)
filename_exp_data_BB = "BB_exp=1.csv"
filepath_exp_data_BB = os.path.join(
    folderpath_exp_output_data, filename_exp_data_BB)





n_r_title = 1 # 表头行号数
n_r_item = 2 # 项行号数
n_r_end = 42 # 结束行号数
n_c_id = 1 # id列号数
n_c_name = 8 # 名称列号数
n_c_money = 9 # 资金列号数
n_c_mark = 67 # 标记列号数
n_c_list = 80 # 列表列号数
n_c_end = 84 # 结束列号数




df_dataBB = pd.read_csv(filepath_exp_data_BB)







# heads = df_dataBB.columns.values
# df_
# df_dataBB.drop('')
# heads["id"]






wb = xw.Book()
wb.save(filepath_excel_exp_data)
ws = wb.sheets[0]
ws.name = "dataBB"
sheet_dataBI = wb.sheets.add(name="dataBI", after="dataBB")
wb.save(filepath_excel_exp_data)





ws.range('A1').value = df_dataBB


wb.save(filepath_excel_exp_data)
wb.close()



xlwb=xl.load_workbook(filepath_excel_exp_data)
xlws=xlwb['dataBB']
# sheet_dataBI = wb_xl['dataBI']


num_cols = xlutils.column_index_from_string('CA')
num_rows = xlws.max_row



# # 设置单元格缩进
# for row in xlws['A1':'CA1']:
#     for cell in row:
#         j.alignment = xl.styles.Alignment(wrapText=True) # 单元格缩进

# 补全title字段名称
xlws['F1'].value = "bankId"
xlws['A1'].value = "id"

# 设置字体
font = Font(name='Times')
for row in xlws.iter_rows(min_row = n_r_title, max_row = n_r_end, min_col = n_c_id, max_col = n_c_end):
    for cell in row:
        cell.font=font

# 设置字段名文本旋转、单元格缩进
align = Alignment(horizontal=None,vertical=None,text_rotation=90,wrap_text=True,shrink_to_fit=True,indent=0) 
for row in xlws.iter_rows(min_row = n_r_title, max_row = n_r_title, min_col = n_c_id, max_col = n_c_end):
    for cell in row:
        cell.alignment=align
        
# 设置title行高
xlws.row_dimensions[1].height=120

# 设置id列宽
for col in range(n_c_id,n_c_name,1):
    xlws.column_dimensions[xlutils.get_column_letter(col)].width=3
    
# 设置name列宽
for col in range(n_c_name,n_c_money,1):
    xlws.column_dimensions[xlutils.get_column_letter(col)].width=5
    
# 设置money列宽
for col in range(n_c_money,n_c_mark,1):
    xlws.column_dimensions[xlutils.get_column_letter(col)].width=8
    
# 设置mark列宽
for col in range(n_c_mark,n_c_list,1):
    xlws.column_dimensions[xlutils.get_column_letter(col)].width=3
    
# 设置list列宽
for col in range(n_c_list,n_c_end,1):
    xlws.column_dimensions[xlutils.get_column_letter(col)].width=12
    

# 设置money数字精度
for row in xlws.iter_rows(min_row = n_r_item, max_row = n_r_end, min_col = n_c_money, max_col = n_c_mark-1):
    for cell in row:
        cell.number_format='0.00'

# 设置mark数字精度
for row in xlws.iter_rows(min_row = n_r_item, max_row = n_r_end, min_col = n_c_mark, max_col = n_c_list-1):
    for cell in row:
        cell.number_format='0'

        
# 冻结单元格
xlws.freeze_panes = 'I2'  # 冻结首行首列





 xlwb.active = True
 sheet_dataBB['B2'].font=Font(
     size=15,
     color='FF000000',
 )


xlwb.save(filepath_excel_exp_data)
xlwb.close()

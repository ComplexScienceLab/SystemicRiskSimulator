{
	"folders": [
		{
			"path": "."
		},
		{
			"name": "SystemicRisk-Library",
			"path": "../SystemicRiskLab/libraries"
		},
		{
			"path": "../entity-relation-system-kit"
		},
		{
			"path": "../ComplexSystemLab/ComplexSystemLab/Projects/cascading_failures"
		},
		{
			"path": "../CS_notebook/Projects/网络级联失效模型"
		},
		{
			"path": "../SystemicRiskLab"
		},
		{
			"path": "../SystemicRiskData/data/sims_samples"
		},
		{
			"path": "../SystemicRiskResearch"
		}
	],
	"settings": {
		"editor.fontLigatures": true,
		"files.autoSave": "onFocusChange",
		"editor.fontFamily": "Times New Roman, Songti SC, STZhongsong, Menlo, Monaco, 'Courier New', monospace, Luxi Mono",
		"python.defaultInterpreterPath": "${workspaceFolder:SystemicRiskSimulator}/.venv/bin/python",
		"r.lsp.promptToInstall": false,
		"git.ignoredRepositories": [
			".",
			"../entity-relation-system-kit",
			"../ComplexSystemLab/ComplexSystemLab/Projects/cascading_failures",
			"../CS_notebook/Projects/网络级联失效模型",
			"../SystemicRiskLab"
		],
		"git.ignoreLimitWarning": true,
		"window.autoDetectColorScheme": true,
"workbench.colorCustomizations": {
			// 亮色模式：青色系 → 浅青
			"MacOS Modern Light - Ventura Xcode Default": {
				"editor.background": "#d7fcff",
				"editor.foreground": "#1e2b2b",
				"editorCursor.foreground": "#0a9ad8",
				"editorLineNumber.foreground": "#6b8b8b",
				"editor.selectionBackground": "#a4f9ff"
			},
			// 暗色模式：青色系 → 深青蓝
			"MacOS Modern Dark - Ventura Xcode Default": {
				"editor.background": "#1e2b2b",
				"editor.foreground": "#eaf6f6",
				"editorCursor.foreground": "#58ccff",
				"editorLineNumber.foreground": "#a6bbbb",
				"editor.selectionBackground": "#1657c7"
			},
			// 兼容内置主题：青色系（亮色）
			"Light 2026": {
				"editor.background": "#d7fcff",
				"editor.foreground": "#1e2b2b",
				"editorCursor.foreground": "#0a9ad8",
				"editorLineNumber.foreground": "#6b8b8b",
				"editor.selectionBackground": "#a4f9ff"
			},
			// 兼容内置主题：青色系（暗色）
			"Dark 2026": {
				"editor.background": "#1e2b2b",
				"editor.foreground": "#eaf6f6",
				"editorCursor.foreground": "#58ccff",
				"editorLineNumber.foreground": "#a6bbbb",
				"editor.selectionBackground": "#1657c7"
			}
		}
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Launch active JS file",
				"program": "${file}",
				"request": "launch",
				"skipFiles": [
					"<node_internals>/**"
				],
				"type": "node"
			},
			{
				"type": "julia",
				"request": "launch",
				"name": "Run active Julia file",
				"program": "${file}",
				"stopOnEntry": false,
				"cwd": "${workspaceFolder}",
				"juliaEnv": "${command:activeJuliaEnvironment}"
			}
		]
	}
}
@article{Ouyang_2020_MeasuringSystemicRiskContagionEffectoftheBankingIndustryinChinaADirectedNetworkApproach,
  title = {Measuring {{Systemic Risk Contagion Effect}} of the {{Banking Industry}} in {{China}}: {{A Directed Network Approach}}},
  shorttitle = {Measuring {{Systemic Risk Contagion Effect}} of the {{Banking Industry}} in {{China}}},
  author = {Ouyang, Zi-Sheng and Huang, Ying and Jia, Yun and Luo, Chang-Qing},
  date = {2020-05-02},
  journaltitle = {Emerging Markets Finance and Trade},
  shortjournal = {Emerging Markets Finance and Trade},
  volume = {56},
  pages = {1312--1335},
  issn = {1540-496X, 1558-0938},
  doi = {10.1080/1540496X.2019.1711368},
  url = {https://www.tandfonline.com/doi/full/10.1080/1540496X.2019.1711368},
  urldate = {2020-06-07},
  abstract = {To capture the impact of investor sentiment on risk contagion of financial institutions and potential tail risks caused by financial network structure, this paper uses a directed network approach to measure systemic risk contagion effect of Chinese banking industry. We use linear quantile lasso regression and local polynomial method to estimate TENET model, and construct a weighted directed network. Moreover, we study directed network from different perspectives, analyze financial risk contagion effect and the influence of investor sentiment on financial risk contagion, and identify systemically important financial institutions. We find that: (1) As crisis spreads, financial system becomes more closely related, and total network connectivity continues to rise until it reaches a maximum value. (2) Total network connectivity and systemic risk have the same upward or downward trend, but systemic risk lags behind total network connectivity. (3) Current bank has characteristics of “too big to fail” and “too contact to fail”.},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Ouyang et al_2020_Measuring Systemic Risk Contagion Effect of the Banking Industry in China.pdf;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Ouyang_2020_MeasuringSystemicRiskContagionEffectoftheBankingIndustryinChinaADirectedNetworkApproach-zotero.md},
  langid = {english},
  number = {6}
}


@article{TaoLing_2016_XiTongXingJinRongFengXianDeJianCeHeDuLiangJiYuZhongGuoJinRongTiXiDeYanJiu,
  title = {系统性金融风险的监测和度量——基于中国金融体系的研究},
  author = {{陶玲} and {朱迎}},
  date = {2016},
  journaltitle = {金融研究},
  pages = {18--36},
  abstract = {国际实践表明,系统性金融风险不仅危及金融稳定,更会给宏观经济和社会财富造成巨大损失。在国际金融危机带来的外部风险输入和我国转轨阶段自身周期性和结构性问题叠加的背景下,我国实体经济与金融体系面临的风险上升并逐步显现。如何构建系统性金融风险的监测和度量方法,从而有效地识别、防范和化解风险成为一个重要而紧迫的课题。本论文借鉴国内外最新的研究和实践成果,在国内外现有研究尚不成熟的方面深入探索。论文将系统性金融风险产生的原因归纳为内部和外部两大因素,将传导机制归纳为内部传导和跨境传导,将扩散机制归纳为信贷紧缩机制、流动性紧缩机制和资产价格波动机制。立足我国转轨体制特点和当前系统性金融风险状况,论文提出了包含7个维度的系统性金融风险综合指数,在采用马尔科夫状态转换方法对综合指数进行实证分析的基础上,识别和判断风险指标的状态和拐点,并度量和预警综合指数状态转移的信息,由此有效衔接宏观审慎和微观审慎,构建一个既可以综合分析整体风险,又可以分解进行局部研究的系统性金融风险监测和度量方法。综合指数模型还引入了指数修正机制以更好地适应中国金融市场的动态发展。},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/TaoLing_2016_XiTongXingJinRongFengXianDeJianCeHeDuLiangJiYuZhongGuoJinRongTiXiDeYanJiu-zotero.md;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/陶玲_朱迎_2016_系统性金融风险的监测和度量——基于中国金融体系的研究.pdf},
  isbn = {1002-7246},
  keywords = {系统性金融风险,风险度量,风险监测},
  number = {06}
}

@article{WenYueChun_2020_XinGuanFeiYanYiQingDuiJinRongYeDeYingXiangJiYingDuiCeLue,
  title = {新冠肺炎疫情对金融业的影响及应对策略},
  author = {闻岳春 and 王丽青 and 李文华 and 裘佳佳},
  date = {2020},
  journaltitle = {上海立信会计金融学院学报},
  volume = {32},
  pages = {3--14},
  abstract = {从短期看,新冠肺炎疫情对中国经济产生了明显影响;从长期看,中国经济继续保持稳步发展的趋势不会变。金融业在做好自身疫情管控的同时,应在党和政府统一领导下,发挥主观能动性,积极应对疫情,做好复工复产工作,实现稳定经济和社会发展等重要目标;同时,要在多重目标中寻求动态平衡,尤其是注重防控金融风险特别是系统性金融风险。基于此,文章提出金融业进一步协同应对等建议。},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/WenYueChun_2020_XinGuanFeiYanYiQingDuiJinRongYeDeYingXiangJiYingDuiCeLue-zotero.md;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/闻岳春_王丽青 et al_2020_新冠肺炎疫情对金融业的影响及应对策略.pdf},
  isbn = {2096-6814},
  keywords = {新冠肺炎疫情,系统性金融风险,金融业},
  number = {02}
}


  author = {Allen, Franklin and Carletti, Elena and Gale, Douglas},
  date = {2009-07},
  journaltitle = {Journal of Monetary Economics},
  shortjournal = {Journal of Monetary Economics},
  volume = {56},
  pages = {639--652},
  issn = {03043932},
  doi = {10.1016/j.jmoneco.2009.04.003},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0304393209000610},
  urldate = {2020-06-07},
  abstract = {We develop a simple model of the interbank market where banks trade a long term, safe asset. When there is a lack of opportunities for banks to hedge idiosyncratic and aggregate liquidity shocks, the interbank market is characterized by excessive price volatility. In such a situation, a central bank can implement the constrained efficient allocation by using open market operations to fix the short term interest rate. It can be constrained efficient for banks to hoard liquidity and stop trading with each other if there is sufficient uncertainty about aggregate liquidity demand compared to idiosyncratic liquidity demand.},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Allen et al_2009_Interbank market liquidity and central bank intervention.pdf;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Allen_2009_Interbankmarketliquidityandcentralbankintervention-zotero.md},
  langid = {english},
  number = {5}
}

@online{Banerjee_2018_DynamicClearingAndContagionInFinancialNetworksa,
  title = {Dynamic {{Clearing}} and {{Contagion}} in {{Financial Networks}}},
  author = {Banerjee, Tathagata and Bernstein, Alex and Feinstein, Zachary},
  date = {2018-05-25},
  url = {http://arxiv.org/abs/1801.02091},
  urldate = {2020-06-07},
  abstract = {In this paper we will consider a generalized extension of the Eisenberg-Noe model of financial contagion to allow for time dynamics in both discrete and continuous time. Derivation and interpretation of the financial implications will be provided. Emphasis will be placed on the continuous-time framework and its formulation as a differential equation driven by the operating cash flows. Mathematical results on existence and uniqueness of firm wealths under the discrete and continuous-time models will be provided. Finally, the financial implications of time dynamics will be considered. The focus will be on how the dynamic clearing solutions differ from those of the static Eisenberg-Noe model.},
  archivePrefix = {arXiv},
  eprint = {1801.02091},
  eprinttype = {arxiv},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Banerjee et al_2018_Dynamic Clearing and Contagion in Financial Networks.pdf;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/Banerjee_2018_DynamicClearingandContagioninFinancialNetworks-zotero.md},
  keywords = {dynamic network,ﬁnancial contagion,ﬁnancial network,Quantitative Finance - Mathematical Finance,Quantitative Finance - Risk Management,Systemic risk},
  langid = {english},
  primaryClass = {q-fin}
}

@article{Battiston_2018_FinancialnetworksandstresstestingChallengesandnewresearchavenuesforsystemicriskanalysisandfinancialstabilityimplications,

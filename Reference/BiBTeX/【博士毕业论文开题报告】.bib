@article{ZhangFengHua_2013_DuoZhuTiMoXingXiaDeYinXingWangLuoLiuDongXingZhuanYi,
  title = {多主体模型下的银行网络流动性转移},
  author = {{张锋华} and {李红刚}},
  date = {2013},
  journaltitle = {内蒙古大学学报(自然科学版)},
  volume = {44},
  pages = {431--434},
  abstract = {流动性危机是银⾏倒闭的重要原因，在⾦融危机形成和传染过程中起关键作⽤)。银⾏⽹络流动性动态配置正是流动性危机形成的微观基础。因此，银⾏⽹络间流动性动态配置对于研 究⾦融危机具有很强的现实意义。构建银⾏⽹络流动性转移的多主体模型可以模拟银⾏⽹络流动性再分配的过程，模拟结果表明银⾏⽹络结构、连接度都对⽹络流动性转移效率有重要影 响 。最后提出了基于这⼀模型给出了提⾼银⾏⽹络流动性转移效率的⻓效机制以及流动性危机的应急措施的政策建议。},
  file = {/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/ZhangFengHua_2013_DuoZhuTiMoXingXiaDeYinXingWangLuoLiuDongXingZhuanYi-zotero.md;/Users/ethan/Library/Mobile Documents/3L68KQB4HG~com~readdle~CommonDocuments/Documents/Zotero/张锋华_李红刚_2013_多主体模型下的银行网络流动性转移.pdf},
  isbn = {1000-1638},
  keywords = {流动性转移,金融危机传染,银行网络},
  number = {04}
}


